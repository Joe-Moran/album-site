{
  "name": "album-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --fix --ext .js,.vue src .storybook vite.config.mjs vitest.setup.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:unit:file": "vitest related --run",
    "test:snapshots": "vitest run src/stories.test.js",
    "snapshots:update": "vitest run src/stories.test.js -u",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen": "npx hygen component new",
    "gen:integration": "npx hygen integration new",
    "prepare": "husky",
    "refreshVSToken": "vsts-npm-auth -config .npmrc"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "mobile-device-detect": "^0.4.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-airbnb": "^8.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.6.1",
    "change-case": "^4.1.2",
    "chromatic": "^13.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "hygen": "^6.2.11",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "sass": "^1.106.1",
    "storybook": "^10.6.3",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "testing-library-selector": "^0.3.1",
    "vite": "^7.3.7",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "eslint-plugin-vue": {
      "postcss-selector-parser": "^7.1.6"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
