{
  "name": "album-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-p format:prettier lint:eslint lint:style",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:snapshots": "vitest run src/stories.test.js",
    "snapshots:update": "vitest run src/stories.test.js -u",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen": "npx hygen component new",
    "gen:integration": "npx hygen integration new",
    "prepare": "husky",
    "format:prettier": "prettier src/ --write",
    "format:prettier:file": "prettier --write",
    "format:prettier:ci": "prettier src/ --check",
    "lint:eslint": "eslint . --fix",
    "lint:eslint:file": "eslint --fix",
    "lint:eslint:ci": "mkdir -p lint/results; eslint . --format junit > lint/results/eslint-lint-result.xml",
    "lint:style": "stylelint \"**/*.(css|scss|vue)\" --fix",
    "lint:style:file": "stylelint --allow-empty-input --fix",
    "lint:style:ci": "stylelint \"**/*.(css|scss|vue)\"",
    "test:file": "vitest related --passWithNoTests --run"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/lint": "^20.5.3",
    "@commitlint/load": "^20.5.3",
    "@dword-design/eslint-plugin-import-alias": "^8.1.8",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-yaml": "^5.0.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.6.1",
    "change-case": "^4.1.2",
    "chromatic": "^13.3.0",
    "eslint": "^10.8.0",
    "eslint-formatter-junit": "^8.40.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-storybook": "^10.5.2",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "hygen": "^6.2.11",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "marked": "^18.1.2",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.6",
    "prettier": "3.5.3",
    "sass": "^1.106.1",
    "storybook": "^10.6.3",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-recommended-scss": "^16.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "testing-library-selector": "^0.3.1",
    "vite": "^7.3.7",
    "vite-imagetools": "^10.0.1",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^4.0.0",
    "zod": "^4.6.7"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
