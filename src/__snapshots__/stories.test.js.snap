exports[`./components/About.stories.js > Renders the Primary story the same as its snapshot 1`] = `
<div>
  <div
    class="about"
    data-v-161b4f7e=""
  >
    <div
      class="image-container"
      data-v-161b4f7e=""
    >
      <img
        data-v-161b4f7e=""
        id="me"
        src="/src/assets/me.png"
      />
    </div>
    <p
      data-v-161b4f7e=""
    >
       xRGB is a MI-based multi-instrumentalist. Refraction is his debut album, and the result of years of adequate agonizing. 11 sonic journal entries without the crutch of vocals. A restless mixtape from a bedroom humanoid aching to get on a stage. Yes…HUMAN. More playing. Less spacebar. More strumming. Less laptop. 
    </p>
  </div>
</div>
`;

